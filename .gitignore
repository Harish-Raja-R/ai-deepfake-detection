# Python byte-code / caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Environments
.venv/
venv/
ENV/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Model weights and artifacts (keep directory, ignore large binaries)
models/*
!models/.gitkeep
*.h5
*.keras
*.joblib
*.pkl
*.onnx

# Data (keep directory structure, ignore local audio files)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Results cache / outputs
results/figures/*
!results/figures/.gitkeep
results/metrics/*
!results/metrics/.gitkeep
results/predictions/*
!results/predictions/.gitkeep

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
